# انسخ الملف ده باسم .env (جنب docker-compose.yml) واملا القيمتين.
# لو عندك .env قديم شغال: استخدمه زي ما هو، نفس الباسورد ونفس مفتاح JWT. متغيّرهمش أبداً.
SQL_SA_PASSWORD=
JWT_SIGNING_KEY=
# سيبها false. السكربت بيرفض يكمل لو اتغيّرت.
SEED_ENABLED=false
# Optional: change the published ports if 8080 / 80 are used by something else (e.g. an old stack).
# ERP_API_PORT=8080
# ERP_WEB_PORT=80
# Optional. First-run setup token. If empty, the API generates a one-time token and prints it in its log (docker compose logs api) while no Admin exists.
# SETUP_TOKEN=
# Optional. Browser origin allowed to call the API from another website (for example https://erp-next-system.vercel.app).
# Leave empty to keep the current behavior (any origin). The normal install serves the web app from the same address and does not need this.
# CORS_ORIGIN=
