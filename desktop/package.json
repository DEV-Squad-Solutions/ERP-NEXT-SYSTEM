{
  "name": "devsquad-erp-desktop",
  "version": "1.0.0",
  "description": "Dev Squad ERP desktop client (Windows). Opens the ERP web app from your own server.",
  "main": "main.js",
  "author": "Dev Squad Solutions",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "check": "node --check main.js && node --check preload.js",
    "dist": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.devsquad.erp.desktop",
    "productName": "Dev Squad ERP",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "server.html", "package.json"],
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }] },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
